rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Bookings belong to a customer by uid, or by email for bookings an admin
    // entered (those have no userId).
    function ownsBooking(booking) {
      return booking.get('userId', null) == request.auth.uid ||
        booking.get('user_email', null) == request.auth.token.get('email', '');
    }

    function isBookingOwner() {
      return isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.user_email == request.auth.token.email
      );
    }

    // A non-admin may never grant themselves a role other than 'user'.
    function keepsUserRole() {
      return request.resource.data.get('role', 'user') == 'user';
    }

    function roleUnchanged() {
      return request.resource.data.get('role', 'user') ==
        resource.data.get('role', 'user');
    }

    // A profile's email must be the account's own (it is used to match
    // bookings and tickets to people).
    function profileEmailIsOwn() {
      let email = request.resource.data.get('email', null);
      return email == null ||
        email.lower() == request.auth.token.get('email', '').lower();
    }

    // "Profile completed" requires the ID and licence photos.
    function profileCompletionValid() {
      let next = request.resource.data;
      return next.get('profile_completed', false) != true ||
        (isHttpsUrl(next.get('national_id_url', null)) &&
          isHttpsUrl(next.get('license_id_url', null)));
    }

    function isHttpsUrl(value) {
      return value is string && value.matches('https://.+');
    }

    function isOwnProfileCreate() {
      return profileEmailIsOwn() && profileCompletionValid();
    }

    // Updates check the email only if it changes, so a profile whose stored
    // email drifted (e.g. an admin typo) can still save its FCM token.
    function isOwnProfileUpdate() {
      return (!request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['email']) || profileEmailIsOwn()) &&
        profileCompletionValid();
    }

    function isUserBookingUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'odometer',
        'tripStatus',
        'updatedAt',
        'kmAllowance',
        'final_amount',
        'extraKmPaymentStatus',
        'status',
        'cancelledAt',
        'pickupVideo',
        'returnVideo',
        'agreement',
        'reviewed',
        'rating',
      ]) && hasValidUserBookingValues();
    }

    // The keys above say WHAT a customer may change; the checks below say to
    // WHICH values. They mirror exactly what the app writes: cancel, record
    // pickup km, record return km (with the extra-km bill), upload condition
    // videos, sign the agreement, and leave a review.
    function hasValidUserBookingValues() {
      let next = request.resource.data;
      let prev = resource.data;
      let changed = next.diff(prev).affectedKeys();
      return serverTime(next, changed, 'updatedAt') &&
        serverTime(next, changed, 'cancelledAt') &&
        statusChangeOk(next, prev, changed) &&
        tripStatusChangeOk(next, prev, changed) &&
        (!changed.hasAny(['odometer']) ||
          isStartingTrip(next, prev) || isEndingTrip(next, prev)) &&
        (!changed.hasAny(['kmAllowance']) || isEndingTrip(next, prev)) &&
        (!changed.hasAny(['extraKmPaymentStatus']) ||
          (!('extraKmPaymentStatus' in prev) &&
            next.extraKmPaymentStatus ==
              (next.kmAllowance.extraKm > 0 ? 'pending' : 'not_applicable'))) &&
        (!changed.hasAny(['final_amount']) ||
          (!('final_amount' in prev) &&
            next.final_amount ==
              prev.get('total_amount', 0) + next.kmAllowance.extraKmChargeEgp)) &&
        writeOnce('pickupVideo', prev, changed) &&
        writeOnce('returnVideo', prev, changed) &&
        writeOnce('agreement', prev, changed) &&
        (!changed.hasAny(['agreement']) || isOwnSignature(next.agreement)) &&
        reviewChangeOk(next, prev, changed);
    }

    // Timestamps the app sets are server timestamps, not client-chosen.
    function serverTime(next, changed, key) {
      return !changed.hasAny([key]) || next[key] == request.time;
    }

    // A signed agreement must be signed by the caller.
    function isOwnSignature(agreement) {
      return agreement.isSigned == true && agreement.signedBy == request.auth.uid;
    }

    // Evidence (condition videos, signed agreement) can be added, never
    // replaced.
    function writeOnce(key, prev, changed) {
      return !changed.hasAny([key]) || !(key in prev);
    }

    function statusChangeOk(next, prev, changed) {
      return !changed.hasAny(['status']) ||
        (next.status == 'cancelled' &&
          prev.status in ['pending', 'confirmed'] &&
          !hasStartedTrip(prev)) ||
        (next.status == 'completed' && isEndingTrip(next, prev));
    }

    function tripStatusChangeOk(next, prev, changed) {
      return !changed.hasAny(['tripStatus']) ||
        (next.tripStatus == 'in_progress' && isStartingTrip(next, prev)) ||
        (next.tripStatus == 'cancelled' && next.status == 'cancelled') ||
        (next.tripStatus == 'completed' && isEndingTrip(next, prev));
    }

    // Once the pickup km is recorded the car is out: no more cancelling.
    function hasStartedTrip(prev) {
      return 'odometer' in prev && prev.odometer != null &&
        'startKm' in prev.odometer;
    }

    // Recording the pickup odometer: once, on an active booking.
    function isStartingTrip(next, prev) {
      return prev.status in ['pending', 'confirmed'] &&
        !hasStartedTrip(prev) &&
        next.odometer.keys().hasOnly(['startKm', 'startPhotoUrl',
          'startPhotoPublicId', 'startCapturedAt', 'startCapturedBy']) &&
        next.odometer.startKm is int && next.odometer.startKm >= 0;
    }

    // Recording the return odometer: once, after pickup, with the extra-km
    // bill computed from the readings.
    function isEndingTrip(next, prev) {
      return hasStartedTrip(prev) &&
        !('endKm' in prev.odometer) &&
        // Only the return fields are added; pickup evidence stays as it was.
        next.odometer.diff(prev.odometer).affectedKeys().hasOnly(['endKm',
          'endPhotoUrl', 'endPhotoPublicId', 'endCapturedAt', 'endCapturedBy']) &&
        next.odometer.endKm is int &&
        next.odometer.endKm >= prev.odometer.startKm &&
        // The bill is part of the same write, never skipped.
        next.keys().hasAll(['kmAllowance', 'final_amount',
          'extraKmPaymentStatus']) &&
        isKmBillCorrect(next.kmAllowance,
          next.odometer.endKm - prev.odometer.startKm,
          billableDays(prev.get('days', 1)));
    }

    // Days as KmBillingService counts them: whole days, clamped to 1..3650.
    function billableDays(raw) {
      let d = raw is number ? int(raw) : 1;
      return d < 1 ? 1 : (d > 3650 ? 3650 : d);
    }

    // Same formula as KmBillingService (lib/services/km_billing_service.dart):
    // 120 km per day included, 5 EGP per extra km. Keep the two in step.
    function isKmBillCorrect(km, driven, days) {
      let allowed = 120 * days;
      let extra = driven > allowed ? driven - allowed : 0;
      return km.kmPerDay == 120 && km.extraKmRateEgp == 5 &&
        km.drivenKm == driven && km.allowedKm == allowed &&
        km.extraKm == extra && km.extraKmChargeEgp == extra * 5;
    }

    // One review per completed booking, rating 1-5.
    function reviewChangeOk(next, prev, changed) {
      return !changed.hasAny(['rating', 'reviewed']) ||
        (prev.status == 'completed' && prev.get('reviewed', false) != true &&
          next.reviewed == true && next.rating is int &&
          next.rating >= 1 && next.rating <= 5);
    }

    // New customer booking: only the fields checkout writes, priced as
    // price per day x days. (Payment itself is simulated in the app.)
    function isValidNewCustomerBooking() {
      let b = request.resource.data;
      return b.keys().hasOnly([
          'userId', 'user_email', 'userName', 'customerName', 'phone',
          'car_id', 'car_name', 'carName', 'brand', 'pickupDate', 'returnDate',
          'startDate', 'days', 'price_per_day', 'total_amount', 'status',
          'payment_method', 'payment_reference', 'payment_status',
          'payer_phone', 'tripStatus',
          'pickupLocation', 'dropoffLocation', 'createdAt', 'agreement',
        ]) &&
        paymentClaimOk(b) &&
        b.userId == request.auth.uid &&
        b.user_email == request.auth.token.get('email', '') &&
        b.status in ['pending', 'confirmed'] &&
        b.tripStatus == 'pending' &&
        b.days is int && b.days >= 1 &&
        b.price_per_day is number && b.price_per_day > 0 &&
        b.total_amount == b.price_per_day * b.days &&
        b.createdAt == request.time &&
        (!('agreement' in b) || b.agreement.signedBy == request.auth.uid);
    }

    // InstaPay and wallet transfers are confirmed by an admin, and online
    // (Paymob) payments by payments_server after Paymob's signed callback.
    // So a customer can never create those already paid or confirmed.
    function paymentClaimOk(p) {
      let method = p.get('payment_method', '');
      let status = p.get('payment_status', '');
      return status in ['', 'paid', 'pending', 'awaiting_verification',
          'unpaid'] &&
        (!(method in ['instapay', 'wallet', 'paymob']) ||
          (p.status == 'pending' &&
            status in ['awaiting_verification', 'unpaid']));
    }

    function isValidCustomerPayment() {
      let p = request.resource.data;
      return p.userId == request.auth.uid &&
        (!(p.get('method', '') in ['instapay', 'wallet', 'paymob']) ||
          p.get('status', '') in ['awaiting_verification', 'unpaid']);
    }

    // Admin-editable settings the app reads at runtime: config/ai (Gemini
    // key and model) and config/payments (payment server URL, InstaPay
    // address, wallet number). Any signed-in user can read them.
    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAdmin() || (
        isOwner(userId) && keepsUserRole() && isOwnProfileCreate()
      );
      allow update: if isAdmin() || (
        isOwner(userId) && roleUnchanged() && isOwnProfileUpdate()
      );
      allow delete: if isAdmin();

      match /chat_messages/{messageId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) || isAdmin();
      }

      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }
    }

    match /cars/{carId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      // Customers refresh the rating summary after reviewing; keep it in
      // range.
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avgRating', 'reviewCount']) &&
        request.resource.data.avgRating is number &&
        request.resource.data.avgRating >= 1 &&
        request.resource.data.avgRating <= 5 &&
        request.resource.data.reviewCount is int &&
        request.resource.data.reviewCount >= 1
      );
    }

    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.user_email == request.auth.token.email ||
        isAdmin()
      );
      allow create: if isAdmin() || (
        isSignedIn() && isValidNewCustomerBooking()
      );
      allow update: if isAdmin() || (
        isBookingOwner() && isUserBookingUpdate()
      );
      // Customers cancel (update) instead of deleting, so billing history is kept.
      allow delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isAdmin() || (
        isSignedIn() && resource.data.userId == request.auth.uid
      );
      allow create: if isAdmin() || (
        isSignedIn() && isValidCustomerPayment()
      );
      allow update, delete: if isAdmin();
    }

    // Customers' actions post alerts (new booking, km recorded, video
    // uploaded) about their own booking; only admins read them. The text is
    // shown to admins and fed to the admin assistant, so it is constrained.
    match /admin_alerts/{alertId} {
      allow create: if isAdmin() || (isSignedIn() && isValidCustomerAlert());
      allow read, update, delete: if isAdmin();
    }

    function isValidCustomerAlert() {
      let a = request.resource.data;
      return a.keys().hasOnly(
          ['title', 'body', 'type', 'bookingId', 'read', 'createdAt']) &&
        a.type in ['new_booking', 'odometer_start', 'odometer_end',
          'video_pickup', 'video_return'] &&
        a.title is string && a.title.size() <= 100 &&
        a.body is string && a.body.size() <= 300 &&
        a.read == false &&
        a.createdAt == request.time &&
        ownsBooking(
          get(/databases/$(database)/documents/bookings/$(a.bookingId)).data);
    }

    // One review per completed booking (the document id is the booking id),
    // written by that booking's customer.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidReview(reviewId);
      allow update, delete: if isAdmin();
    }

    function isValidReview(reviewId) {
      let r = request.resource.data;
      let booking =
        get(/databases/$(database)/documents/bookings/$(reviewId)).data;
      return r.keys().hasOnly(['bookingId', 'carId', 'carName', 'rating',
          'comment', 'userId', 'userName', 'createdAt']) &&
        r.bookingId == reviewId &&
        r.userId == request.auth.uid &&
        r.rating is int && r.rating >= 1 && r.rating <= 5 &&
        r.comment is string && r.comment.size() <= 2000 &&
        ownsBooking(booking) &&
        booking.status == 'completed' &&
        booking.get('reviewed', false) != true;
    }

    // Chauffeur contact details: admins only (customers get the assigned
    // chauffeur's name and phone copied onto their booking).
    match /chauffeurs/{chauffeurId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Gift / complimentary rentals: admin only, never shown to customers
    match /complimentary_rentals/{rentalId} {
      allow read, write: if isAdmin();
    }

    // Traffic tickets: admins manage them; customers can see and pay their own
    match /traffic_violations/{violationId} {
      function isViolationOwner() {
        return isSignedIn() && (
          resource.data.userId == request.auth.uid ||
          resource.data.user_email == request.auth.token.email
        );
      }

      function isUserViolationPayment() {
        return resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'paidAt', 'payment_method', 'paidBy']) &&
          request.resource.data.status in ['pending', 'paid'];
      }

      allow read: if isAdmin() || isViolationOwner();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (isViolationOwner() && isUserViolationPayment());
    }
  }
}
